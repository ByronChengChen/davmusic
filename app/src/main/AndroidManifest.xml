<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限声明 -->
    <!-- 仅需网络权限：下载写入 App 私有目录（getExternalFilesDir），
         上传通过系统文件选择器（SAF）由系统代读，均无需存储权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 后台播放：锁屏后 CPU 可能休眠，导致播完一首无法自动切下一首。
         MediaPlayer.setWakeMode() 与切歌窗口的 PARTIAL_WAKE_LOCK 需要此权限。
         属于 normal 级权限，无需运行时申请。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 前台服务：让播放服务在后台/锁屏时不被系统回收（实现保活）。
         Android 9+ 需要 FOREGROUND_SERVICE；
         Android 14+ 还必须声明具体的服务类型 MEDIA_PLAYBACK。
         二者均为 normal 级权限，无需运行时申请。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 13+ 发送通知需要运行时授权；未授权时前台服务仍可运行，
         只是通知不可见。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DavMusic"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <!-- 服务器配置界面（启动入口） -->
        <activity
            android:name="com.byron.davmusic.ServerConfigActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 主界面：使用 NoActionBar 主题，因为它用 Toolbar 替代 ActionBar。
             主题若带 ActionBar，setSupportActionBar() 会抛 IllegalStateException

             launchMode=singleTask：切回前台时复用已有实例并重建到栈顶，
             避免系统为同一个界面创建多个 Activity 实例（多实例会导致
             导航栈混乱、返回时路径错位）。 -->
        <activity
            android:name="com.byron.davmusic.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DavMusic.NoActionBar"
            android:screenOrientation="portrait" />
        
        <!-- 播放前台服务：承载播放状态与常驻通知，实现后台保活。
             foregroundServiceType 必须与代码中 startForeground 声明的类型一致
             （Android 14+ 强制校验，不一致会抛异常）。 -->
        <service
            android:name="com.byron.davmusic.MusicService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 文件提供者（用于文件共享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>
        
    </application>

</manifest>
