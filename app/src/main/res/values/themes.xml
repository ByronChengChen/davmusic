<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- 应用主题 -->
    <style name="Theme.DavMusic" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- 辅助色 -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        
        <!-- 表面色：Material 组件（对话框、菜单、卡片）跟随它 -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorError">@color/error</item>

        <!-- 背景色 -->
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        
        <!-- 文本颜色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- 控件样式 -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        
        <!-- 按钮样式 -->
        <item name="materialButtonStyle">@style/Widget.DavMusic.Button</item>
        
        <!-- 工具栏样式 -->
        <item name="toolbarStyle">@style/Widget.DavMusic.Toolbar</item>
        <item name="actionBarStyle">@style/Widget.DavMusic.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.DavMusic.Toolbar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.DavMusic.Toolbar</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="alertDialogTheme">@style/Theme.DavMusic.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.DavMusic.ProgressDialog</item>
        <item name="buttonStyle">@style/Widget.DavMusic.PlainButton</item>
        
        <!-- 编辑框样式：必须是 EditText 系样式；TextInputLayout 的样式
             由布局单独指定。此处若误用 TextInputLayout 样式，其 box*
             专有属性会导致 inflate 崩溃 -->
        <item name="editTextStyle">@style/Widget.DavMusic.TextInputEditText</item>
        
        <!-- 列表项样式 -->
        <item name="android:listDivider">@color/divider</item>
        
        <!-- 支持夜间模式 -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    
    <!-- 无 ActionBar 主题 -->
    <!-- 无 ActionBar 主题：供使用 Toolbar 的 Activity 使用。
         继承 Theme.DavMusic 以保留配色，并显式关闭 ActionBar 相关的三个属性。
         若遗漏任何一个，setSupportActionBar() 会抛 IllegalStateException -->
    <style name="Theme.DavMusic.NoActionBar" parent="Theme.DavMusic">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>
    
    <!-- 对话框主题 -->
    <style name="Theme.DavMusic.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@color/surface</item>
    </style>
    
    <!-- 按钮样式 -->
    <style name="Widget.DavMusic.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_margin">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/button_tint</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    
    <!-- 工具栏样式 -->
    <style name="Widget.DavMusic.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@color/toolbar_text</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="android:background">@color/toolbar_background</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.DavMusic.Toolbar</item>
        <item name="navigationIconTint">@color/accent</item>
        <item name="android:theme">@style/ThemeOverlay.DavMusic.Toolbar</item>
        <item name="popupTheme">@style/ThemeOverlay.DavMusic.Toolbar</item>
    </style>
    
    <!-- 编辑框样式 -->
    <!-- TextInputLayout 样式（供布局 style= 引用） -->
    <style name="Widget.DavMusic.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_margin">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- 内层 EditText 样式（供主题 editTextStyle 引用）
         必须是 EditText 系样式，不能是 TextInputLayout 样式 -->
    <style name="Widget.DavMusic.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:backgroundTint">@color/accent</item>
    </style>
    
    <!-- 卡片样式 -->
    <style name="Widget.DavMusic.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
    
    <!-- 进度条样式 -->
    <style name="Widget.DavMusic.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>
    
    <!-- 播放器进度条样式 -->
    <style name="Widget.DavMusic.PlayerProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/player_progress</item>
        <item name="android:minHeight">3dp</item>
        <item name="android:maxHeight">3dp</item>
    </style>
    
    <style name="TextAppearance.DavMusic.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/toolbar_text</item>
    </style>
    <style name="Widget.DavMusic.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/toolbar_background</item>
        <item name="titleTextStyle">@style/TextAppearance.DavMusic.Toolbar</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.DavMusic.PlainButton" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@color/button_tint</item>
        <item name="android:background">@drawable/button_surface</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.DavMusic.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="Theme.DavMusic.ProgressDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
    <style name="ThemeOverlay.DavMusic.Toolbar" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:textColorPrimary">@color/toolbar_text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>
</resources>
