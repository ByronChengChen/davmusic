<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="72dp" android:padding="12dp"
    android:background="@drawable/item_background">
    <TextView android:id="@+id/searchSongTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/searchSongLocation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/searchSongDownload" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_secondary" />
</LinearLayout>
